+import { test, expect, APIRequestContext } from '@playwright/test';
+import { adminContext, createBook, deleteBook } from '../../../core/utils/cartApi';
+
+// Guests: no stored login
+test.use({ storageState: { cookies: [], origins: [] } });
+
+test.describe('E2E: add to cart', () => {
+  let admin: APIRequestContext;
+  let bookId: number;
+  let title: string;
+
+  test.beforeAll(async () => {
+    admin = await adminContext();
+    const b = await createBook(admin, 5, 12.5);
+    bookId = b.id;
+    title = b.title;
+  });
+  test.afterAll(async () => {
+    await deleteBook(admin, bookId);
+    await admin.dispose();
+  });
+
+  test('@e2e @cart guest adds 3 copies on the book page; cart shows quantity, subtotal and badge', async ({ page }) => {
+    await page.goto(`/books/${bookId}`);
+    await page.getByTestId('book-detail-quantity-input').fill('3');
+    await page.getByTestId('book-detail-add-to-cart-button').click();
+    await expect(page.getByTestId('cart-count-badge')).toHaveText('3');
+    await page.getByTestId('nav-cart-button').click();
+    await expect(page.getByTestId('cart-page')).toBeVisible();
+    await expect(page.getByTestId('cart-items-list')).toContainText(title);
+    await expect(page.locator('[data-testid^=cart-item-quantity-]')).toHaveValue('3');
+    await expect(page.locator('[data-testid^=cart-item-subtotal-]')).toContainText('$37.50');
+    await expect(page.getByTestId('cart-total')).toHaveText('$37.50');
+    await page.reload(); // guest cart survives a reload (cookie)
+    await expect(page.getByTestId('cart-total')).toHaveText('$37.50');
+  });
+
+  test('@e2e @cart book page refuses more than the stock and keeps the cart unchanged', async ({ page }) => {
+    await page.goto(`/books/${bookId}`);
+    await page.getByTestId('book-detail-quantity-input').fill('6');
+    await page.getByTestId('book-detail-add-to-cart-button').click();
+    await expect(page.locator('[data-sonner-toast]')).toContainText('Only 5 in stock');
+    await expect(page.getByTestId('cart-count-badge')).toHaveCount(0);
+  });
+
+  test('@e2e @cart out-of-stock book has a disabled Add to Cart button on the book page', async ({ page }) => {
+    const oos = await createBook(admin, 0);
+    try {
+      await page.goto(`/books/${oos.id}`);
+      await expect(page.getByTestId('book-detail-stock')).toContainText('Out of Stock');
+      await expect(page.getByTestId('book-detail-add-to-cart-button')).toBeDisabled();
+    } finally {
+      await deleteBook(admin, oos.id);
+    }
+  });
+
+  // Known defect (out/bugs/BUG-2-cart-quantity-multidigit-typing.md): fails until the product is fixed.
+  test('@e2e @cart typing a multi-digit quantity in the cart gives that number', async ({ page }) => {
+    const big = await createBook(admin, 50, 10);
+    try {
+      await page.goto(`/books/${big.id}`);
+      await page.getByTestId('book-detail-quantity-input').fill('5');
+      await page.getByTestId('book-detail-add-to-cart-button').click();
+      await expect(page.getByTestId('cart-count-badge')).toHaveText('5');
+      await page.getByTestId('nav-cart-button').click();
+      const qty = page.locator('[data-testid^=cart-item-quantity-]');
+      await expect(qty).toHaveValue('5');
+      await qty.click();
+      await page.keyboard.press('ControlOrMeta+A');
+      await page.keyboard.type('12', { delay: 100 });
+      await expect(page.getByTestId('cart-total')).toHaveText('$120.00');
+      await expect(page.getByTestId('cart-count-badge')).toHaveText('12');
+    } finally {
+      await deleteBook(admin, big.id);
+    }
+  });
+
+  // Known defect (out/bugs/BUG-1-guest-checkout-login-no-redirect.md): fails until the product is fixed.
+  test('@e2e @cart guest who proceeds to checkout from the cart lands on checkout after signing in', async ({ page }) => {
+    await page.goto(`/books/${bookId}`);
+    await page.getByTestId('book-detail-add-to-cart-button').click();
+    await expect(page.getByTestId('cart-count-badge')).toHaveText('1');
+    await page.getByTestId('nav-cart-button').click();
+    await page.getByTestId('proceed-to-checkout-button').click();
+    await expect(page).toHaveURL(/\/login\?callbackUrl=/);
+    await page.getByTestId('login-email-input').fill(process.env.USER_EMAIL ?? '');
+    await page.getByTestId('login-password-input').fill(process.env.USER_PASSWORD ?? '');
+    await page.getByTestId('login-submit-button').click();
+    try {
+      await expect(page).toHaveURL(/\/checkout$/, { timeout: 10_000 });
+      await expect(page.getByTestId('checkout-page')).toBeVisible();
+    } finally {
+      // clean up the merged cart of the shared user
+      await page.evaluate(() => fetch('/api/cart', { method: 'DELETE' }));
+    }
+  });
+});
