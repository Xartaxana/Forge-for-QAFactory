+            {"task_id": "t-9"}, {"task_id": None}, "not an object", {"task_id": "t-999999999ab"}]
+    assert jk.max_by_letter(objs) == {"": 123, "a": 102, "ab": 999999999}      # t-0123 is readable: number 123
+    st = jk.BandState()
+    for o in objs:
