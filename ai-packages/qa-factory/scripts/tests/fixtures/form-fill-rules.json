    "work/bug-drafts/": "group N2d not landed",
    "test-report.md": "group N2d not landed",
    "project:bugs/": "group N2d not landed",
    "project:obligations.md": "group N2d not landed",
    "retro.md": "group N2d not landed",
    "project:factory-backlog.md": "group N2d not landed"
  }
}
