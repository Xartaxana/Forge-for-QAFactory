#!/bin/sh
# The hook's exit code must reflect the FIRST failing check, not the
# last command in the file (a review blocker: a journal_validator failure
# must not be masked by a passing escape_check): gate() stops at the first refusal.
# Output policy (owner 16.11.2026): on success ONE line `gates: ok (N checks)`; a gate that
# fails prints its full output and stops the commit; a gate that passes but printed a line
# containing WARN is shown WHOLE (header and detail lines); a line `WARN: ok ...` alone is not a warning.
# Gates run in the same order as always.
n=0
crashed=""
tmp=$(mktemp "${TMPDIR:-/tmp}/precommit.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

# warn_show: a passing gate's output holding a WARN other than the success line `WARN: ok ...` is printed whole.
warn_show() {
    if grep 'WARN' "$tmp" | grep -qv '^WARN: ok'; then
        cat "$tmp"
    fi
}

# gate <command...>: run it, capture stdout+stderr; on failure print its full text and exit with its own code.
gate() {
    if "$@" >"$tmp" 2>&1; then
        n=$((n + 1))
        warn_show
    else
        rc=$?
        cat "$tmp"
        exit "$rc"
    fi
}

# Routing-journal validator: the staged logs/routing-log.jsonl doesn't
# break append-only / typed fields / the role-vs-tier acceptance matrix.
gate python tools/journal_validator.py
# Escape-allowlist: CLAUDE.md's permanent escape/concession clauses stay
# hash-pinned to their authorizing decision-log section. NOTE: this
# toolkit ships no tools/escape_allowlist.json by default (see
# tools/escape_allowlist.template.json) -- a deployment that has not set
# one up yet will see this step fail closed until it copies the template
# and fills in real entries (see that file's own instructions).
gate python tools/escape_check.py
# Enforcement-chain probe: a staged change touching the chain itself
# (.githooks/*, .claude/settings.json, tools/wiring_check.py, or any
# tools/*.py the two source files above reference as a hook command)
# is verified against the chain's own OBSERVER (tools/wiring_check.py)
# before the commit lands -- fail-closed when that observer itself
# reports a problem or cannot even run.
gate python tools/enforcement_probe.py
# Factory rules index: docs/FACTORY_RULES_INDEX.md (read by the coordinator on
# the SessionStart `COORDINATOR RULES:` line, tools/coordinator_rules.py) is
# regenerated from ai-packages/qa-factory/design/factory-rules.md; a rules
# change without a regenerated index does not land.
gate python tools/factory_rules_index.py --check
# Architecture index: docs/ARCHITECTURE_INDEX.md (the AR-n ids the commit-msg gate checks against; <= 3 KB)
# is regenerated from ai-packages/qa-factory/design/architecture.md; a change to the invariants without a
# regenerated index does not land.
gate python tools/architecture_index.py --check
# AGENTS.md (the Codex copy of CLAUDE.md + the coordinator files, hooks and roles) is
# generated; a change to any source without a regenerated file does not land.
gate python tools/agents_md.py --check
# One road for language branches (FG7-27, FG7-87): the staged run counts only the staged scripts and the
# files whose baseline rows differ (0.65-1.7 s measured, t-1449); a commit that grows a token falls back to
# the whole scan (9-14 s), rare and by design.
gate python tools/language_sites.py --check --staged
# Forge attribution (WARN only): new backlog rows / package files / journal events without a
# feature are printed whole (offenders and doors) so the developer sees them at commit time;
# --warn never blocks: whatever its exit code, the commit goes on (as the old `|| true`); a crash's
# traceback is printed in full and the check is not counted.
if python tools/forge_metrics.py --check --base HEAD --warn >"$tmp" 2>&1; then
    n=$((n + 1))
    warn_show
else
    cat "$tmp"
    crashed="forge_metrics"
fi
if [ -n "$crashed" ]; then
    echo "gates: ok ($n checks, $crashed did not run)"
else
    echo "gates: ok ($n checks)"
fi
