{
  "model": "claude-fable-5-1",
  "autoCompactWindow": 350000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/agent_budget.py"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/dispatch_gate.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hygiene_gate.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/claim_control_gate.py"
          },
          {
            "type": "command",
            "command": "python tools/handoff_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/dod_track.py"
          },
          {
            "type": "command",
            "command": "python tools/journal_echo.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/search_control_gate.py"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/negative_lint.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/dod_gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/main_gate.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/compact_snapshot.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "qa-factory@qafactory": false,
    "backlog@forge-mods": true,
    "cost-band@forge-mods": true,
    "cost-band@inline": false
  },
  "extraKnownMarketplaces": {
    "forge-mods": {
      "source": {
        "source": "directory",
        "path": "./tools/claude-mods"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(python tools/ci_read.py *)",
      "Bash(python -B tools/ci_read.py *)",
      "Bash(python tools/piles.py check *)",
      "Bash(python tools/piles.py board --check)",
      "Bash(python tools/test_quarantine.py status)",
      "Bash(python tools/test_quarantine.py check)",
      "Bash(python tools/lint_ratchet.py --check)",
      "Bash(python tools/dup_ratchet.py --check)",
      "Bash(python tools/journal_keys.py *)",
      "Bash(python tools/critic_verdict_check.py *)",
      "Bash(python -m pytest tools/*)",
      "Bash(python -m pyflakes *)",
      "Bash(python -B ai-packages/qa-factory/scripts/tests/*)",
      "Bash(python -B ai-packages/qa-factory/scripts/selftest.py --limits --lang)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git worktree list)",
      "PowerShell(python tools/ci_read.py *)",
      "PowerShell(python -B tools/ci_read.py *)",
      "PowerShell(python tools/piles.py check *)",
      "PowerShell(python tools/piles.py board --check)",
      "PowerShell(python tools/test_quarantine.py status)",
      "PowerShell(python tools/test_quarantine.py check)",
      "PowerShell(python tools/lint_ratchet.py --check)",
      "PowerShell(python tools/dup_ratchet.py --check)",
      "PowerShell(python tools/journal_keys.py *)",
      "PowerShell(python -m pytest tools/*)",
      "PowerShell(python -m pyflakes *)",
      "PowerShell(python -B ai-packages/qa-factory/scripts/tests/*)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git diff *)",
      "PowerShell(git worktree list)",
      "PowerShell(Get-Date *)"
    ]
  }
}
